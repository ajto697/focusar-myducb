{
  "manifest_version": 3,
  "name": "FocusAR Guardian - Tab & Idle Monitor",
  "version": "1.0.0",
  "description": "Theo dõi tab active và phát hiện xao nhãng bảo vệ phiên học 2 phút cho FocusAR.",
  "permissions": [
    "tabs",
    "activeTab",
    "idle",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusAR Guardian Status"
  }
}
