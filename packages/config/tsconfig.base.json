{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Base Config",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": false,
    "isolatedModules": true,
    "moduleResolution": "node",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@focus-ar/types": ["../types/src"],
      "@focus-ar/db": ["../db/src"],
      "@focus-ar/ai": ["../ai/src"],
      "@focus-ar/cv": ["../cv/src"],
      "@focus-ar/ui": ["../ui/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
